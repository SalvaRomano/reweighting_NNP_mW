
# -------------------------------
# NNP settings
# -------------------------------
variable nnpDir    string "/data/fs201232/sr41880/reweighting/nnp-water/"
variable nnpCutoff equal 4.3065

# -------------------------------
# System definition
# -------------------------------
units metal
atom_style atomic
boundary p p p

read_data input.data
Reading data file ...
  orthogonal box = (0 0 0) to (12.505259 12.505259 12.505259)
  1 by 1 by 1 MPI processor grid
  reading atoms ...
  64 atoms
  read_data CPU = 0.001 seconds
replicate 2 2 2
Replication is creating a 2x2x2 = 8 times larger system...
  orthogonal box = (0 0 0) to (25.010519 25.010519 25.010519)
  1 by 1 by 1 MPI processor grid
  512 atoms
  replicate CPU = 0.000 seconds
mass 1 18.015

# -------------------------------
# NNP potential
# -------------------------------
pair_style hdnnp ${nnpCutoff} dir ${nnpDir} showew no resetew yes maxew 1000000
pair_style hdnnp 4.3065 dir ${nnpDir} showew no resetew yes maxew 1000000
pair_style hdnnp 4.3065 dir /data/fs201232/sr41880/reweighting/nnp-water/ showew no resetew yes maxew 1000000
pair_coeff * * O

# -------------------------------
# Neighbor list
# -------------------------------
neighbor 1.0 bin
neigh_modify delay 0 every 1 check yes

# -------------------------------
# Thermodynamic output
# -------------------------------
thermo_style custom step time temp pe etotal press vol density lx ly lz enthalpy
thermo 1
thermo_modify flush yes

# -------------------------------
# Rerun trajectory
# -------------------------------
timestep 0.002

rerun "/data/fs201232/sr41880/reweighting/mW_NVT/N_512/water.lammpstrj" dump x y z box yes

