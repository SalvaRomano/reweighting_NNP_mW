
# -------------------------------
# System definition
# -------------------------------
units metal
atom_style atomic
boundary p p p

read_data input.data
Reading data file ...
  orthogonal box = (0 0 0) to (19.720578 19.720578 19.720578)
  1 by 1 by 1 MPI processor grid
  reading atoms ...
  256 atoms
  read_data CPU = 0.002 seconds


# Replicate initial small cell to match saved trajectory
replicate 2 2 2
Replication is creating a 2x2x2 = 8 times larger system...
  orthogonal box = (0 0 0) to (39.441156 39.441156 39.441156)
  1 by 1 by 1 MPI processor grid
  2048 atoms
  replicate CPU = 0.000 seconds


mass 1 18.015

# -------------------------------
# mW potential
# -------------------------------
pair_style sw
pair_coeff * * /data/fs201232/sr41880/reweighting/mW.sw mW
newton on

# -------------------------------
# Neighbor list
# -------------------------------
neighbor 1.0 bin
neigh_modify delay 0 every 1 check yes

# -------------------------------
# Thermodynamic output
# -------------------------------
thermo_style custom step time temp pe etotal press vol density lx ly lz enthalpy
thermo 1
thermo_modify flush yes

# -------------------------------
# Rerun trajectory
# -------------------------------
timestep 0.001

rerun /data/fs201232/sr41880/reweighting/NN_NVT/N_2048/run_5/water.lammpstrj dump x y z box yes
